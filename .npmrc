# Recent npm versions (11.6+) gate dependency lifecycle scripts behind an
# allow-list and only warn about the ones that were never reviewed. OpenNext
# cannot bundle the Worker without the binary that esbuild's postinstall puts
# in place, `wrangler` needs workerd's, and ESLint's resolver needs
# unrs-resolver's. Approving them here keeps `npm ci` reproducible everywhere:
# locally, in GitHub Actions and on Cloudflare Workers Builds.
allow-scripts=esbuild,workerd,unrs-resolver

# Never let npm silently skip every lifecycle script. A newly introduced,
# unreviewed script should be reported without turning a Cloudflare install
# into a hard failure; the build-critical packages above remain explicit.
strict-allow-scripts=false
ignore-scripts=false
