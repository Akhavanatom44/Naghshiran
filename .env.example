# PostgreSQL connection string. Required for registration, sign-in and order submission at runtime.
DATABASE_URL=postgresql://postgres:password@host:5432/naghshiran

# Use a unique random value of at least 32 characters in production.
SESSION_SECRET=replace-with-a-long-random-secret
# Optional: absolute public origin for social metadata (e.g. https://your-domain.tld)
NEXT_PUBLIC_SITE_URL=

# Optional: notifications are skipped when these are unset.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_IDS=
