# The app runs on Cloudflare Workers and stores data in the D1 database
# d1_naghshiran (binding DB, see wrangler.jsonc). No DATABASE_URL needed.
#
# Local development (next dev / opennextjs-cloudflare preview):
#   copy this file to .dev.vars — values there are picked up automatically.
#
# Production (Cloudflare Workers / Workers Builds):
#   set these as environment variables in the Worker/Workers Builds settings
#   (or with npx wrangler secret put <NAME> for Workers deploys).

# Optional but recommended: unique random value of at least 32 characters.
# When unset (or too short), the app auto-provisions a strong random secret
# and stores it in the D1 `app_settings` table, so login/register work with
# zero configuration. A configured value always wins and must stay stable.
SESSION_SECRET=
# Optional: absolute public origin for social metadata (e.g. https://your-domain.tld)
NEXT_PUBLIC_SITE_URL=

# Optional: notifications are skipped when these are unset.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_IDS=
