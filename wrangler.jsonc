{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "naghshiran",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-08",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "d1_naghshiran",
      "database_id": "96fcda7f-4093-47d2-b210-75b749658c65"
    }
  ]
}
